# Core application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Public allergy-card update workflow
# Keep disabled until the migration and Turnstile keys are deployed.
ALLERGY_PUBLIC_UPDATES_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
TURNSTILE_ALLOWED_HOSTNAME=localhost
ALLERGY_RATE_LIMIT_SECRET=replace-with-a-separate-long-random-secret

# Email delivery
EMAIL_FROM=your-system@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-system@gmail.com
SMTP_PASS=replace-with-an-app-password

# Optional outside Vercel. The app also detects common Chrome/Edge locations.
CHROME_EXECUTABLE_PATH=
